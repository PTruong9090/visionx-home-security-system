DATABASE_URL=postgresql+asyncpg://USERNAME:PASSWORD@HOST:PORT/DATABASE
ALEMBIC_DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:PORT/DATABASE
GO2RTC_PUBLIC_URL=http://localhost:1984
CORS_ALLOWED=["http://localhost:5173","http://127.0.0.1:5173"]

# AUTH
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# HEALTH CHECK
HEALTH_CHECK_INTERVAL_SECONDS=300
RTSP_TIMEOUT_MS=5000

# GO2RTC STREAM RECONCILE
STREAM_RECONCILE_INTERVAL_SECONDS=900

# COOKIES
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# RESET PASSWORD TOKEN
RESET_TOKEN_EXPIRE_MINUTES=15
FRONTEND_URL=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@email.com
SMTP_FROM_NAME=VisionX
SMTP_STARTTLS=True

# REDIS
REDIS_URL=redis://localhost:6379/0